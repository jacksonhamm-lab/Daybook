{
  // Daybook + the workout app on one private hostname (same origin, so they share localStorage).
  // Access control is a Cloudflare Access application on apps.jacksonhamm.ca, set in the dashboard.
  "name": "daybook",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-17",
  // No public *.workers.dev or preview URLs: they would bypass Access.
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "apps.jacksonhamm.ca", "custom_domain": true }],
  // Cross-device sync store. SYNC_KEYS (allowed sync-code hashes) is a secret, set in the dashboard.
  "kv_namespaces": [{ "binding": "SYNC", "id": "c331c9c1a4f8497ea216a83728fb2890" }],
  // Reminder checks run every minute; the Worker decides what is due in the user's timezone.
  // Public half of the push signing key (safe to publish); the private JWK is a secret.
  "vars": { "VAPID_PUBLIC": "BJc22OTUACjlb4f8EFB7-xMdNNsfFIE3aRUrQTeyWR1_3ryMEfyhYT2ovAPI9KOjMD9Nfani9iSgJJMPHx4PEEI", "VAPID_SUBJECT": "mailto:jackson.hamm@icloud.com" },
  "triggers": { "crons": ["* * * * *"] },
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  }
}
